# ─── Required ───
NEXT_PUBLIC_SUPABASE_URL=https://issymeofzaxaocquapgs.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: Admin Panel ───
# Set to your Supabase user ID to enable /admin
NEXT_PUBLIC_ADMIN_USER_ID=

# ─── Optional: WalletConnect ───
# Get at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# ─── Optional: Cloudflare R2 Storage ───
# Falls back to Supabase Storage if not set
NEXT_PUBLIC_R2_ACCOUNT_ID=
NEXT_PUBLIC_R2_ACCESS_KEY_ID=
NEXT_PUBLIC_R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_R2_BUCKET=orbit-media
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Server-only (keep secret) ───
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
